# Source URL for OpenAPI client generation (codegen only — never exposed to browsers).
# Point this at a running backend when running: pnpm generate:api
# In CI, override this to point at a deployed backend instance.
API_BASE_URL=http://localhost:8080

# Browser-visible API base URL used by the Next.js web app at runtime.
# Distinct from API_BASE_URL: this is what the browser (or SSR) calls at request time.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Anthropic API key for the chapter tutor (ia module).
# Get yours at console.anthropic.com — never commit the real value.
BRIO_IA_API_KEY=sk-ant-...
