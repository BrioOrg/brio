        {
          "id": "def-cercle-circonscrit",
          "type": "callout",
          "variant": "definition",
          "title": "Cercle circonscrit",
          "text": "Les trois médiatrices d'un triangle se coupent en un même point O. Ce point est à la même distance des trois sommets : c'est le centre du cercle qui passe par les trois sommets, le **cercle circonscrit** au triangle."
        },
        {
          "id": "def-triangle-rectangle",
          "type": "callout",
          "variant": "definition",
          "title": "Cas du triangle rectangle",
          "text": "Si un triangle est rectangle, le centre de son cercle circonscrit est le **milieu de son hypoténuse**. Le rayon vaut la moitié de l'hypoténuse."
        },
