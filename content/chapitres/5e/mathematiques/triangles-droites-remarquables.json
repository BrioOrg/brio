    {
      "id": "aire",
      "title": "L'aire d'un triangle",
      "kind": "lesson",
      "estimatedDurationMinutes": 12,
      "blocks": [
        {
          "id": "formule-aire-triangle",
          "type": "formula",
          "latex": "\\mathcal{A} = \\frac{\\text{base} \\times \\text{hauteur}}{2}"
        },
        {
          "id": "tip-hauteur-base",
          "type": "callout",
          "variant": "tip",
          "title": "Une hauteur pour chaque base",
          "text": "La hauteur à utiliser est celle qui est perpendiculaire à la base choisie. Sur la figure de la hauteur, avec la base [BC], la hauteur est AH."
        },
        {
          "id": "ex-aire-simple",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Un triangle a une base de 8 cm et une hauteur relative à cette base de 5 cm. Quelle est son aire ?",
