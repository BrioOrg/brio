            "c4.geo.espace.relier-patron"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 3,
          "answer": 12.56,
          "tolerance": 0.02,
          "unit": "cm",
          "explanation": "La longueur du rectangle est le périmètre du disque de base : 2 × π × 2 ≈ 2 × 3,14 × 2 = 12,56 cm. La hauteur 5 cm est l'autre dimension du rectangle."
        },
