            },
            {
              "id": "choix-des-segments-perpendiculaires",
              "text": "des segments perpendiculaires",
              "correct": false
            },
            {
              "id": "choix-des-segments-de-meme-longueur",
              "text": "des segments de même longueur, forcément",
              "correct": false
            }
          ],
          "explanation": "La perspective cavalière conserve le parallélisme. Elle ne conserve pas toujours les longueurs : les fuyantes sont raccourcies."
        },
        {
          "id": "ex-nombre-cachees",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Dans le dessin habituel d'un cube en perspective cavalière (vu de face, un peu par-dessus et par la droite), combien d'arêtes sont cachées ?",
          "competencies": [
            "c4.geo.espace.representer-perspective"
          ],
          "difficulty": "approfondissement",
          "estimatedDurationMinutes": 2,
          "answer": 3,
          "tolerance": 0,
          "explanation": "Le sommet arrière en bas à gauche est caché : les 3 arêtes qui en partent sont cachées. Les 9 autres arêtes du cube sont visibles."
        }
      ]
    },
