          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "answer": 30,
          "tolerance": 0,
          "unit": "cm³",
          "explanation": "5 × 3 × 2 = 30 cm³."
        },
        {
          "id": "ex-volume-cube",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Calcule le volume d'un cube d'arête 4 cm.",
          "competencies": [
            "c4.gm.volumes.calculer-pave-prisme"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "answer": 64,
          "tolerance": 0,
          "unit": "cm³",
          "explanation": "$4^3$ = 4 × 4 × 4 = 64 cm³."
        },
        {
          "id": "ex-volume-prisme",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Un prisme droit a pour base un triangle rectangle dont les côtés de l'angle droit mesurent 3 cm et 4 cm. Sa hauteur est 10 cm. Calcule son volume.",
          "competencies": [
            "c4.gm.volumes.calculer-pave-prisme"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 3,
          "answer": 60,
          "tolerance": 0,
          "unit": "cm³",
          "explanation": "Aire de la base : 3 × 4 ÷ 2 = 6 cm². Volume : 6 × 10 = 60 cm³. Oublier la division par 2 donnerait 120 cm³."
        },
        {
          "id": "ex-volume-cylindre",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Calcule le volume d'un cylindre de rayon 2 cm et de hauteur 5 cm, en prenant π ≈ 3,14.",
          "competencies": [
            "c4.gm.volumes.calculer-cylindre"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 2,
          "answer": 62.8,
          "tolerance": 0.1,
          "unit": "cm³",
          "explanation": "Aire de la base : 3,14 × $2^2$ = 12,56 cm². Volume : 12,56 × 5 = 62,8 cm³."
        },
        {
          "id": "ex-cylindre-diametre",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Un cylindre a un diamètre de 10 cm et une hauteur de 4 cm. Quel calcul donne son volume ?",
          "competencies": [
            "c4.gm.volumes.calculer-cylindre"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "multiple": false,
          "choices": [
            {
              "id": "choix-5-2-4",
              "text": "π × $5^2$ × 4",
              "correct": true
            },
            {
              "id": "choix-10-2-4",
              "text": "π × $10^2$ × 4",
              "correct": false
            },
            {
              "id": "choix-2-5-4",
              "text": "2 × π × 5 × 4",
              "correct": false
            }
          ],
          "explanation": "Le rayon est la moitié du diamètre : 5 cm. Volume : π × $5^2$ × 4 = 100π ≈ 314 cm³. « π × $10^2$ » prend le diamètre pour le rayon : le résultat est 4 fois trop grand. « 2 × π × 5 × 4 » est l'aire du rectangle du patron, pas un volume."
        }
      ]
    },
