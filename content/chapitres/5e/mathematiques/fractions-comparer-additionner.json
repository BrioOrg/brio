    {
      "id": "additionner",
      "title": "Additionner et soustraire",
      "kind": "lesson",
      "estimatedDurationMinutes": 15,
      "blocks": [
        {
          "id": "def-meme-denominateur",
          "type": "callout",
          "variant": "definition",
          "title": "Avec le même dénominateur",
          "text": "On additionne (ou on soustrait) les numérateurs et on garde le dénominateur : $\\frac{3}{5}$ + $\\frac{4}{5}$ = $\\frac{7}{5}$."
        },
        {
          "id": "methode-denominateurs-differents",
          "type": "steps",
          "title": "Calculer 2/5 + 1/4",
          "steps": [
            {
              "text": "On cherche un multiple commun aux dénominateurs 5 et 4 : 20."
            },
            {
              "text": "On écrit chaque fraction avec le dénominateur 20.",
              "formula": "\\frac{2}{5} = \\frac{8}{20} \\qquad \\frac{1}{4} = \\frac{5}{20}"
            },
            {
              "text": "On additionne les numérateurs.",
              "formula": "\\frac{8}{20} + \\frac{5}{20} = \\frac{13}{20}"
            }
          ]
        },
        {
          "id": "warning-additionner-denominateurs",
          "type": "callout",
          "variant": "warning",
          "title": "On n'additionne pas les dénominateurs",
          "text": "$\\frac{1}{2}$ + $\\frac{1}{2}$ fait 1, pas $\\frac{2}{4}$. Les dénominateurs indiquent la taille des parts : ils ne s'additionnent pas."
        },
        {
          "id": "ex-add-meme",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Combien vaut $\\frac{3}{5}$ + $\\frac{4}{5}$ ?",
