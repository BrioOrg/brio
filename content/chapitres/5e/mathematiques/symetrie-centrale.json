        },
        {
          "id": "def-proprietes",
          "type": "callout",
          "variant": "definition",
          "title": "Ce que conserve le demi-tour",
          "text": "Le symétrique d'une figure par un demi-tour lui est **superposable** : le demi-tour conserve les **longueurs**, les **angles**, les **aires** et l'**alignement**. De plus, l'image d'une droite est une droite qui lui est **parallèle**."
        },
        {
          "id": "ex-conserve-longueur",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Le segment [BC] mesure 6,2 cm. Combien mesure son symétrique [B'C'] par un demi-tour ?",
          "competencies": [
            "c4.geo.transformations.utiliser-proprietes-demi-tour"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "answer": 6.2,
          "tolerance": 0,
          "unit": "cm",
          "explanation": "Le demi-tour conserve les longueurs : B'C' = BC = 6,2 cm."
        },
        {
          "id": "ex-conserve-angle",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Un angle mesure 47°. Combien mesure son symétrique par un demi-tour ?",
          "competencies": [
            "c4.geo.transformations.utiliser-proprietes-demi-tour"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "answer": 47,
          "tolerance": 0,
          "unit": "°",
          "explanation": "Le demi-tour conserve les angles : l'angle symétrique mesure aussi 47°."
        },
        {
          "id": "ex-image-droite",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Le point O n'est pas sur la droite (d). Quelle est l'image de (d) par le demi-tour de centre O ?",
          "competencies": [
            "c4.geo.transformations.utiliser-proprietes-demi-tour"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "multiple": false,
          "choices": [
            {
              "id": "choix-une-droite-parallele-a-d",
              "text": "une droite parallèle à (d)",
              "correct": true
            },
            {
              "id": "choix-une-droite-perpendiculaire-a-d",
              "text": "une droite perpendiculaire à (d)",
              "correct": false
            },
            {
              "id": "choix-la-droite-d-elle-meme",
              "text": "la droite (d) elle-même",
              "correct": false
            }
          ],
          "explanation": "Faire un demi-tour, c'est tourner de 180° : une droite garde sa direction, son image est donc parallèle à (d). Elle n'est pas confondue avec (d) quand O n'est pas sur (d) ; si O était sur (d), l'image serait (d) elle-même."
        }
      ]
    },
