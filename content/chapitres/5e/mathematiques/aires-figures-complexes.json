        {
          "id": "auto-aire-rectangle",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Quelle est l'aire d'un rectangle de 7 cm sur 4 cm ?",
          "competencies": [],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "answer": 28,
          "tolerance": 0,
          "unit": "cm²",
          "explanation": "Longueur × largeur : 7 × 4 = 28 cm²."
        }
      ]
    },
    {
      "id": "parallelogramme",
      "title": "L'aire d'un parallélogramme",
      "kind": "lesson",
      "estimatedDurationMinutes": 14,
      "blocks": [
        {
          "id": "intro-parallelogramme",
          "type": "prose",
          "text": "On découpe le triangle qui dépasse d'un côté d'un parallélogramme et on le recolle de l'autre côté : on obtient un rectangle de même base et de même hauteur."
        },
        {
          "id": "formule-parallelogramme",
          "type": "formula",
          "latex": "\\mathcal{A} = \\text{base} \\times \\text{hauteur}"
        },
        {
          "id": "fig-parallelogramme-hauteur",
          "type": "figure",
          "alt": "Parallélogramme ABCD avec [AB] horizontal en bas. Le segment [DH] descend verticalement de D jusqu'à H sur [AB], avec un angle droit en H.",
          "caption": "La hauteur [DH] relative à la base [AB].",
          "spec": {
