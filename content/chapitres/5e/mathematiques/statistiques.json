    {
      "id": "moyenne",
      "title": "La moyenne",
      "kind": "lesson",
      "estimatedDurationMinutes": 12,
      "blocks": [
        {
          "id": "def-moyenne",
          "type": "callout",
          "variant": "definition",
          "title": "Moyenne",
          "text": "La **moyenne** d'une série de valeurs est la somme des valeurs divisée par le nombre de valeurs. C'est la valeur que chacun aurait si l'on répartissait le total de façon égale."
        },
        {
          "id": "ex-moyenne-notes",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Lina a eu 12, 15, 9 et 14. Quelle est sa moyenne ?",
          "competencies": [
            "c4.ogd.statistiques.calculer-moyenne"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 2,
          "answer": 12.5,
          "tolerance": 0,
          "explanation": "Somme : 12 + 15 + 9 + 14 = 50. Nombre de notes : 4. Moyenne : 50 ÷ 4 = 12,5."
        },
        {
          "id": "ex-moyenne-temperatures",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Voici les températures relevées à 8 h pendant une semaine, en °C : 3 ; 5 ; −1 ; 2 ; 6 ; 4 ; 2. Quelle est la température moyenne ?",
          "competencies": [
            "c4.ogd.statistiques.calculer-moyenne"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 3,
          "tolerance": 0,
          "unit": "°C",
          "explanation": "Somme : 3 + 5 − 1 + 2 + 6 + 4 + 2 = 21. Nombre de valeurs : 7. Moyenne : 21 ÷ 7 = 3 °C. Attention à la valeur négative."
        },
        {
          "id": "ex-moyenne-valeur",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "La moyenne d'une série est-elle forcément l'une des valeurs de la série ?",
          "competencies": [
            "c4.ogd.statistiques.calculer-moyenne"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 1,
          "multiple": false,
          "choices": [
            {
              "id": "choix-non",
              "text": "Non",
              "correct": true
            },
            {
              "id": "choix-oui",
              "text": "Oui",
              "correct": false
            },
            {
              "id": "choix-oui-c-est-toujours-la-valeur-d",
              "text": "Oui, c'est toujours la valeur du milieu",
              "correct": false
            }
          ],
          "explanation": "La moyenne de 12, 15, 9 et 14 est 12,5, qui n'est aucune des notes. La valeur du milieu d'une série rangée s'appelle la médiane (vue plus tard) : ce n'est pas la même chose."
        }
      ]
    },
