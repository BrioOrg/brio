        {
          "id": "ex-tomates",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Les tomates coûtent 2,40 € le kilo. Combien coûtent 4,3 kg ?",
          "competencies": [
            "c4.ogd.proportionnalite.utiliser-coefficient"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 2,
          "answer": 10.32,
          "tolerance": 0,
          "unit": "€",
          "explanation": "On multiplie par le prix unitaire : 4,3 × 2,40 = 10,32 €."
        },
        {
          "id": "ex-vitesse",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Une voiture parcourt 180 km en 2 h, à vitesse constante. Quelle est sa vitesse moyenne en km/h ?",
          "competencies": [
            "c4.ogd.proportionnalite.utiliser-coefficient"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 90,
          "tolerance": 0,
          "unit": "km/h",
          "explanation": "La vitesse moyenne est la distance parcourue en 1 h : 180 ÷ 2 = 90 km/h."
        },
        {
          "id": "ex-echelle",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Sur une carte à l'échelle 1/50 000, deux villages sont à 3 cm l'un de l'autre. Quelle est la distance réelle, en km ?",
          "competencies": [
            "c4.ogd.proportionnalite.utiliser-coefficient"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 3,
          "answer": 1.5,
          "tolerance": 0,
          "unit": "km",
          "explanation": "1/50 000 : 1 cm sur la carte représente 50 000 cm en réalité. 3 cm représentent 150 000 cm = 1 500 m = 1,5 km."
        },
        {
          "id": "ex-recette-six",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Une recette pour 4 personnes demande 300 g de farine. Combien en faut-il pour 6 personnes ?",
          "competencies": [
            "c4.ogd.proportionnalite.utiliser-coefficient"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 450,
          "tolerance": 0,
          "unit": "g",
          "explanation": "Retour à l'unité : pour 1 personne, 300 ÷ 4 = 75 g ; pour 6 personnes, 75 × 6 = 450 g. Autre méthode : 6 = 4 + 2, donc 300 + 150 = 450 g."
        }
      ]
    },
    {
      "id": "pourcentages",
      "title": "Les pourcentages",
      "kind": "lesson",
      "estimatedDurationMinutes": 14,
      "blocks": [
        {
          "id": "def-pourcentage",
          "type": "callout",
          "variant": "definition",
          "title": "Pourcentage",
          "text": "Prendre t % d'une quantité, c'est la multiplier par $\\frac{t}{100}$. Un pourcentage exprime aussi une **proportion** : 6 filles sur 24 élèves, c'est $\\frac{6}{24}$ = $\\frac{25}{100}$ = 25 %."
        },
        {
          "id": "table-pourcentages-faciles",
          "type": "table",
          "headers": [
            "Prendre…",
            "c'est…"
          ],
          "rows": [
            [
              "50 %",
              "la moitié"
            ],
            [
              "25 %",
              "le quart"
            ],
            [
              "10 %",
              "diviser par 10"
            ],
            [
              "1 %",
              "diviser par 100"
            ]
          ],
          "caption": "Des pourcentages à calculer de tête."
        },
        {
          "id": "ex-dix-pourcent",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Calcule 10 % de 80.",
          "competencies": [
            "c4.ogd.proportionnalite.appliquer-pourcentages"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "answer": 8,
          "tolerance": 0,
          "explanation": "10 %, c'est diviser par 10 : 80 ÷ 10 = 8."
        },
        {
          "id": "ex-vingt-cinq-pourcent",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Calcule 25 % de 60.",
          "competencies": [
            "c4.ogd.proportionnalite.appliquer-pourcentages"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "answer": 15,
          "tolerance": 0,
          "explanation": "25 %, c'est le quart : 60 ÷ 4 = 15."
        },
        {
          "id": "ex-delegues",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Pour l'élection des délégués, Chloé a obtenu 12 voix sur 24. Quel pourcentage des voix a-t-elle obtenu ?",
          "competencies": [
            "c4.ogd.proportionnalite.appliquer-pourcentages"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 50,
          "tolerance": 0,
          "unit": "%",
          "explanation": "12 sur 24, c'est la moitié : 50 %. Ou : 12 ÷ 24 = 0,5 = $\\frac{50}{100}$."
        },
        {
          "id": "ex-solde",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Un pull coûte 40 €. Il est soldé de 30 %. Quel est son nouveau prix ?",
          "competencies": [
            "c4.ogd.proportionnalite.appliquer-pourcentages"
          ],
          "difficulty": "approfondissement",
          "estimatedDurationMinutes": 3,
          "answer": 28,
          "tolerance": 0,
          "unit": "€",
          "explanation": "La réduction est 30 % de 40 € : 40 × 30 ÷ 100 = 12 €. Nouveau prix : 40 − 12 = 28 €. Attention : 12 € est la réduction, pas le prix."
        }
      ]
    },
