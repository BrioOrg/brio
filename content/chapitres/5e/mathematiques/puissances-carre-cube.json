              "correct": true
            },
            {
              "id": "choix-4-3",
              "text": "$4^3$",
              "correct": true
            },
            {
              "id": "choix-6-2",
              "text": "$6^2$",
              "correct": false
            },
            {
              "id": "choix-32-2",
              "text": "$32^2$",
              "correct": false
            }
          ],
          "explanation": "$8^2$ = 8 × 8 = 64 et $4^3$ = 4 × 4 × 4 = 64. $6^2$ = 36. $32^2$ est bien plus grand : 32 × 2 = 64, mais c'est un double, pas un carré."
        },
        {
          "id": "ex-carre-11",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Combien vaut $11^2$ ?",
          "competencies": [
            "c4.num.puissances.connaitre-carres"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 1,
          "answer": 121,
          "tolerance": 0,
          "explanation": "11 × 11 = 110 + 11 = 121."
        },
        {
          "id": "ex-aire-carre",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Quelle est l'aire, en cm², d'un carré de côté 7 cm ?",
          "competencies": [
            "c4.num.puissances.connaitre-carres"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "answer": 49,
          "tolerance": 0,
          "unit": "cm²",
          "explanation": "L'aire d'un carré de côté c est $c^2$ : $7^2$ = 49 cm²."
        },
        {
          "id": "ex-difference-puissances",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Calcule $10^3 - 6^2$.",
          "competencies": [
            "c4.num.puissances.calculer-expressions"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 964,
          "tolerance": 0,
          "explanation": "$10^3$ = 1 000 et $6^2$ = 36. Puis 1 000 − 36 = 964."
        },
        {
          "id": "ex-expression-litterale",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Calcule $x^2 + 3x$ pour x = 4.",
          "competencies": [
            "c4.num.puissances.calculer-expressions"
          ],
          "difficulty": "approfondissement",
          "estimatedDurationMinutes": 3,
          "answer": 28,
          "tolerance": 0,
          "explanation": "On remplace x par 4 : $4^2$ + 3 × 4 = 16 + 12 = 28. Attention : 3x signifie 3 × x."
        }
      ]
    }
  ]
}
