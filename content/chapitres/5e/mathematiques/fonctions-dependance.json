        {
          "id": "tip-lire",
          "type": "callout",
          "variant": "tip",
          "title": "Lire une valeur",
          "text": "Pour lire la température à une heure donnée, on part de cette heure sur l'axe horizontal, on monte jusqu'à la courbe, puis on se déplace horizontalement jusqu'à l'axe vertical."
        },
        {
          "id": "ex-lire-midi",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "D'après le graphique, quelle température fait-il à 12 h ?",
          "competencies": [
            "c4.ogd.fonctions.lire-graphique"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "answer": 16,
          "tolerance": 0,
          "unit": "°C",
          "explanation": "Au-dessus de 12 h, le point est à la hauteur de 16 sur l'axe vertical : 16 °C."
        },
        {
          "id": "ex-lire-maximum",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "À quelle heure la température relevée est-elle la plus élevée ?",
          "competencies": [
            "c4.ogd.fonctions.lire-graphique"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 16,
          "tolerance": 0,
          "unit": "h",
          "explanation": "Le point le plus haut est au-dessus de 16 h, à 18 °C. Attention : on demande l'heure (16 h), pas la température."
        },
        {
          "id": "ex-variation",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Entre 4 h et 16 h, comment varie la température ?",
          "competencies": [
            "c4.ogd.fonctions.lire-graphique"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 1,
          "multiple": false,
          "choices": [
            {
              "id": "choix-elle-augmente",
              "text": "Elle augmente",
              "correct": true
            },
            {
              "id": "choix-elle-diminue",
              "text": "Elle diminue",
              "correct": false
            },
            {
              "id": "choix-elle-reste-constante",
              "text": "Elle reste constante",
              "correct": false
            }
          ],
          "explanation": "De 4 h à 16 h, la courbe monte : la température passe de 4 °C à 18 °C. Elle diminue ensuite, de 16 h à minuit."
        },
        {
          "id": "ex-placer-point",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "On veut placer dans un repère le point qui correspond à la colonne « x = 3, y = 7 » d'un tableau de valeurs. Où le place-t-on ?",
          "competencies": [
            "c4.ogd.fonctions.lire-graphique"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "multiple": false,
          "choices": [
            {
              "id": "choix-a-l-abscisse-3-et-a-l-ordonnee",
              "text": "À l'abscisse 3 et à l'ordonnée 7",
              "correct": true
            },
            {
              "id": "choix-a-l-abscisse-7-et-a-l-ordonnee",
              "text": "À l'abscisse 7 et à l'ordonnée 3",
              "correct": false
            },
            {
              "id": "choix-sur-l-axe-horizontal-entre-3-e",
              "text": "Sur l'axe horizontal, entre 3 et 7",
              "correct": false
            }
          ],
          "explanation": "La première ligne du tableau (x) se lit sur l'axe horizontal, la deuxième (y) sur l'axe vertical : le point a pour coordonnées (3 ; 7). Inverser les deux donne un autre point."
        }
      ]
    },
    {
      "id": "formule",
      "title": "Écrire une formule",
      "kind": "lesson",
      "estimatedDurationMinutes": 12,
      "blocks": [
        {
          "id": "exemple-formules",
          "type": "callout",
          "variant": "example",
          "title": "Deux tarifs de cinéma",
          "text": "Tarif A : 5 € par séance. Pour n séances, on paie P = 5n. Tarif B : un abonnement de 10 €, puis 3 € par séance. Pour n séances, on paie P = 10 + 3n."
        },
        {
          "id": "ex-formule-tarif-a",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Une séance de cinéma coûte 5 €. Quelle formule donne le prix P de n séances ?",
          "competencies": [
            "c4.ogd.fonctions.produire-formule"
          ],
          "difficulty": "introduction",
          "estimatedDurationMinutes": 1,
          "multiple": false,
          "choices": [
            {
              "id": "choix-p-5n",
              "text": "P = 5n",
              "correct": true
            },
            {
              "id": "choix-p-n-5",
              "text": "P = n + 5",
              "correct": false
            },
            {
              "id": "choix-p-5",
              "text": "P = 5",
              "correct": false
            }
          ],
          "explanation": "Chaque séance coûte 5 € : n séances coûtent 5 × n. « n + 5 » ajoute 5 une seule fois. « P = 5 » ne dépend pas du nombre de séances."
        },
        {
          "id": "ex-formule-abonnement",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Un abonnement coûte 10 €, puis chaque séance coûte 3 €. Quelle formule donne le prix P pour n séances ?",
          "competencies": [
            "c4.ogd.fonctions.produire-formule"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "multiple": false,
          "choices": [
            {
              "id": "choix-p-10-3n",
              "text": "P = 10 + 3n",
              "correct": true
            },
            {
              "id": "choix-p-13n",
              "text": "P = 13n",
              "correct": false
            },
            {
              "id": "choix-p-10n-3",
              "text": "P = 10n + 3",
              "correct": false
            }
          ],
          "explanation": "On paie 10 € une seule fois, plus 3 € par séance : 10 + 3n. « 13n » fait payer l'abonnement à chaque séance. « 10n + 3 » inverse le prix fixe et le prix par séance."
        },
        {
          "id": "ex-formule-perimetre",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Un rectangle a une longueur de 6 cm et une largeur ℓ (en cm). Quelle formule donne son périmètre P en fonction de ℓ ?",
          "competencies": [
            "c4.ogd.fonctions.produire-formule"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "multiple": false,
          "choices": [
            {
              "id": "choix-p-12-2",
              "text": "P = 12 + 2ℓ",
              "correct": true
            },
            {
              "id": "choix-p-6",
              "text": "P = 6ℓ",
              "correct": false
            },
            {
              "id": "choix-p-6-2",
              "text": "P = 6 + ℓ",
              "correct": false
            }
          ],
          "explanation": "P = 2 × (6 + ℓ) = 12 + 2ℓ. « 6ℓ » est l'aire du rectangle. « 6 + ℓ » est la moitié du périmètre."
        }
      ]
    },
    {
      "id": "exercices",
      "title": "Exercices",
      "kind": "exercises",
      "estimatedDurationMinutes": 10,
      "blocks": [
        {
          "id": "ex-formule-tableau",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Un tableau de valeurs contient : x = 1 → y = 4 ; x = 2 → y = 7 ; x = 3 → y = 10. Quelle formule lui correspond ?",
          "competencies": [
            "c4.ogd.fonctions.produire-formule"
          ],
          "difficulty": "approfondissement",
          "estimatedDurationMinutes": 3,
          "multiple": false,
          "choices": [
            {
              "id": "choix-y-3x-1",
              "text": "y = 3x + 1",
              "correct": true
            },
            {
              "id": "choix-y-4x",
              "text": "y = 4x",
              "correct": false
            },
            {
              "id": "choix-y-x-3",
              "text": "y = x + 3",
              "correct": false
            }
          ],
          "explanation": "Quand x augmente de 1, y augmente de 3 : on a 3x plus un nombre fixe. Pour x = 1 : 3 + 1 = 4. On vérifie : 3 × 3 + 1 = 10. « 4x » marche pour x = 1 mais donne 8 pour x = 2. « x + 3 » donne 5 pour x = 2."
        },
        {
          "id": "ex-nombre-fois",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "D'après le graphique de la température, à combien des heures relevées la température est-elle de 8 °C ?",
          "competencies": [
            "c4.ogd.fonctions.lire-graphique"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 2,
          "tolerance": 0,
          "explanation": "Les points à 8 °C sont ceux de 8 h et de 24 h : il y en a deux."
        },
        {
          "id": "ex-tableau-formule",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Avec la formule P = 10 + 3n (abonnement de cinéma), combien paie-t-on pour 4 séances ?",
          "competencies": [
            "c4.ogd.fonctions.utiliser-tableau-valeurs"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 1,
          "answer": 22,
          "tolerance": 0,
          "unit": "€",
          "explanation": "On remplace n par 4 : 10 + 3 × 4 = 10 + 12 = 22 €."
        }
      ]
    }
  ]
}
