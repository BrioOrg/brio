        {
          "id": "ex-final-trois-adjacents",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Trois angles adjacents, placés côte à côte, forment ensemble un angle plat. Deux d'entre eux mesurent 40° et 75°. Combien mesure le troisième ?",
          "competencies": [
            "c3.geo.angles.connaitre-mesurer-construire"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 65,
          "tolerance": 0,
          "unit": "°",
          "explanation": "Un angle plat mesure 180°. 40 + 75 = 115, donc le troisième mesure 180 − 115 = 65°."
        },
        {
          "id": "ex-final-angle-plein",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Combien mesure un angle plein ?",
          "competencies": [
            "c3.geo.angles.connaitre-mesurer-construire"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "multiple": false,
          "choices": [
