    {
      "id": "mesurer-construire",
      "title": "Mesurer et construire un angle",
      "kind": "lesson",
      "estimatedDurationMinutes": 14,
      "blocks": [
        {
          "id": "methode-mesurer",
          "type": "steps",
          "title": "Mesurer un angle avec le rapporteur",
          "steps": [
            {
              "text": "On place le centre du rapporteur sur le sommet de l'angle."
            },
            {
              "text": "On aligne la graduation 0 avec un des côtés."
            },
            {
              "text": "On lit la mesure sur l'autre côté, en suivant **la graduation qui part de 0** sur le premier côté."
            }
          ]
        },
        {
          "id": "piege-graduations",
          "type": "callout",
          "variant": "warning",
          "title": "Deux graduations",
          "text": "Le rapporteur porte deux échelles, de 0 à 180 dans les deux sens. Avant de lire, demande-toi si l'angle est aigu ou obtus : un angle obtus ne peut pas mesurer 50°."
        },
        {
          "id": "ex-erreur-rapporteur",
          "type": "exercise",
          "exerciseType": "multiple-choice",
          "prompt": "Yanis mesure un angle qui est visiblement obtus et lit 50°. Quelle est probablement la vraie mesure ?",
          "competencies": [
            "c3.geo.angles.connaitre-mesurer-construire"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "multiple": false,
          "choices": [
            {
              "id": "choix-130",
              "text": "130°",
              "correct": true
            },
            {
              "id": "choix-50",
              "text": "50°, sa lecture est juste.",
              "correct": false
            },
            {
              "id": "choix-230",
              "text": "230°",
              "correct": false
            },
            {
              "id": "choix-90",
              "text": "90°",
              "correct": false
            }
          ],
          "explanation": "Yanis a lu sur la mauvaise échelle. Les deux échelles donnent des mesures qui font 180° à elles deux : 180 − 50 = 130°. 130° est bien obtus. 50° serait aigu, 230° dépasse l'angle plat, et 90° est un angle droit."
        },
        {
          "id": "methode-construire",
          "type": "steps",
          "title": "Construire un angle xOy de 70°",
          "steps": [
            {
              "text": "On trace une demi-droite [Ox)."
            },
            {
              "text": "On place le centre du rapporteur sur O et le 0 sur [Ox)."
            },
            {
              "text": "On fait une marque en face de 70°, sur la graduation qui part de [Ox)."
            },
            {
              "text": "On trace la demi-droite [Oy) qui passe par cette marque."
            }
          ]
        },
        {
          "id": "ex-construire-angle",
          "type": "exercise",
          "exerciseType": "paper",
          "prompt": "Sur ton cahier, construis un angle $\\widehat{xOy}$ de 125°.",
          "competencies": [
            "c3.geo.angles.connaitre-mesurer-construire"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 3,
          "solution": "Trace [Ox), place le centre du rapporteur en O et le 0 sur [Ox), marque 125° sur la graduation qui part de [Ox), puis trace [Oy). Contrôle : l'angle obtenu doit être obtus, plus ouvert qu'un angle droit."
        }
      ]
    },
    {
