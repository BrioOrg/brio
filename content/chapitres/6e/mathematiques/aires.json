          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 14,
          "tolerance": 0,
          "unit": "m²",
          "explanation": "A = 4 × 3,5 = 14 m²."
        },
        {
          "id": "ex-final-forme-l",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Une pièce en forme de L est faite d'un rectangle de 5 m sur 3 m et d'un carré de 2 m de côté, collés sans se chevaucher. Quelle est son aire ?",
          "competencies": [
            "c3.gm.aires.calculer-carre-rectangle"
          ],
          "difficulty": "standard",
          "estimatedDurationMinutes": 2,
          "answer": 19,
          "tolerance": 0,
          "unit": "m²",
          "explanation": "On découpe la figure en morceaux simples : 5 × 3 = 15 m² et 2 × 2 = 4 m². Aire totale : 15 + 4 = 19 m²."
        },
        {
          "id": "ex-final-unites-differentes",
          "type": "exercise",
          "exerciseType": "numeric",
          "prompt": "Un panneau rectangulaire mesure 1,2 m sur 50 cm. Quelle est son aire en cm² ?",
          "competencies": [
            "c3.gm.aires.calculer-carre-rectangle",
            "c3.gm.aires.convertir"
          ],
          "difficulty": "approfondissement",
          "estimatedDurationMinutes": 3,
          "answer": 6000,
          "tolerance": 0,
          "unit": "cm²",
          "explanation": "On met d'abord les longueurs dans la même unité : 1,2 m = 120 cm. A = 120 × 50 = 6 000 cm². (Multiplier 1,2 par 50 donnerait 60, un nombre sans unité cohérente.)"
        }
      ]
    }
  ]
