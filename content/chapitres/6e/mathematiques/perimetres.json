      "blocks": [
        {
          "id": "intro-composees",
          "type": "prose",
          "text": "Le contour d'une figure peut mêler des segments et des **arcs de cercle**. On calcule chaque morceau du contour séparément, puis on additionne. Un demi-cercle a pour longueur la moitié du périmètre du cercle entier."
        },
        {
          "id": "methode-demi-disque",
          "type": "steps",
          "title": "Périmètre d'un demi-disque de diamètre 8 cm",
          "steps": [
            {
              "text": "Longueur de l'arc : la moitié du périmètre du cercle.",
              "formula": "\\frac{3,14 \\times 8}{2} = 12,56 \\text{ cm}"
            },
            {
              "text": "On ajoute le diamètre, qui ferme le contour.",
              "formula": "12,56 + 8 = 20,56 \\text{ cm}"
            }
          ]
        },
