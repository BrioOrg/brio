{
  "env_allowlist": [".env.example", ".env.sample", ".env.template"],
  "patterns": [
    {
      "name": "private key header",
      "regex": "-----BEGIN( RSA| EC| DSA| OPENSSH| PGP)? PRIVATE KEY",
      "flags": []
    },
    {
      "name": "Anthropic API key (sk-ant-)",
      "regex": "\\bsk-ant-[A-Za-z0-9_-]{20,}",
      "flags": []
    },
    {
      "name": "OpenAI-style API key (sk-)",
      "regex": "\\bsk-[A-Za-z0-9]{20,}",
      "flags": []
    },
    {
      "name": "AWS access key ID",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b",
      "flags": []
    },
    {
      "name": "Google API key",
      "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "flags": []
    },
    {
      "name": "high-entropy secret assignment",
      "regex": "(?:password|passwd|secret|api[_-]?key|token|credential|private[_-]?key|auth[_-]?token)\\s*[=:]\\s*['\"]?[A-Za-z0-9+/=_-]{20,}",
      "flags": ["IGNORECASE"]
    }
  ]
}
