# Backend URL the Next.js server calls (SSR, route handlers), read at runtime.
# The browser always calls /api on its own origin; `next dev` proxies it here.
# Copy to .env.local and adjust for your environment.
API_INTERNAL_URL=http://localhost:8080

# Per-session request cap for the chapter tutor, read by the server at request
# time (a restart applies a change). Default: 20. Lower if usage data justifies a
# tighter bound.
TUTEUR_REQUEST_CAP=20
