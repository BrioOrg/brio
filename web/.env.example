# Backend API base URL used by the web app at runtime (SSR + browser).
# Copy to .env.local and adjust for your environment.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Dev-only Basic auth credentials for the Spring API.
# Replaced when the identite module ships real authentication.
# Never commit real values here — set them in .env.local only.
NEXT_PUBLIC_BRIO_API_USERNAME=
NEXT_PUBLIC_BRIO_API_PASSWORD=

# Per-session request cap for the chapter tutor. Build-time config in Next.js
# (NEXT_PUBLIC_* is inlined at build time — changing it requires a new deploy).
# Default: 20. Lower if usage data justifies a tighter bound.
NEXT_PUBLIC_TUTEUR_REQUEST_CAP=20
