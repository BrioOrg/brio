# Deployed environment configuration (ADR 0024 §4). Copy to deploy/.env on the
# server and fill in; deploy/.env is gitignored and must never be committed.
# Every difference between environments lives here — never in images or code.

# --- Domain ------------------------------------------------------------------
# Public hostname Caddy serves and gets a Let's Encrypt certificate for.
# Use `localhost` to try the stack on a laptop (Caddy then uses its own local CA;
# expect a certificate warning, or `curl -k`).
BRIO_DOMAIN=brio.example.fr

# --- Access (Caddy basic_auth) -------------------------------------------------
# One account per person: CADDY_HASH_n goes with CADDY_USER_n. Generate a hash with
# (it prompts for the password, which then stays out of the shell history):
#   docker run --rm -it caddy:2.10-alpine caddy hash-password
# Keep the hash in single quotes: it contains `$`, which compose would otherwise
# try to interpolate.
CADDY_USER_1=pierce
CADDY_HASH_1='$2a$14$replace-with-a-real-bcrypt-hash'
CADDY_USER_2=gabrielle
CADDY_HASH_2='$2a$14$replace-with-a-real-bcrypt-hash'
# Value of the cookie Caddy hands out after a correct password, so the browser is
# asked only once. Anyone holding it gets in without a password: generate it with
# `openssl rand -hex 32` (hex only — it is used inside a regular expression) and
# change it whenever an account is revoked.
BRIO_GATE_TOKEN=change-me

# --- Database ------------------------------------------------------------------
POSTGRES_DB=brio
POSTGRES_USER=brio
# Long and random, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=change-me

# --- E-mail (ADR 0024 §6) -------------------------------------------------------
# Private environment: Mailpit captures every e-mail (read them at
# https://$BRIO_DOMAIN/mailpit); nothing leaves the server. The defaults below
# point at it. At publication, set these to the EU provider's SMTP server — the
# only change needed. Sender: Brio <no-reply@$BRIO_DOMAIN>.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# true for a real provider (authenticated, STARTTLS required); false for Mailpit.
SMTP_AUTH=false
SMTP_STARTTLS=false

# --- Database scripts (scripts/env/restore.sh, reset.sh) --------------------------
# The private environment holds fictional data only (ADR 0024 §8), so its database
# may be overwritten. Remove this line at publication: both scripts then refuse to run.
BRIO_RESET_ALLOWED=true

# --- Fictional établissement (ADR 0029 §5) ------------------------------------------
# Created at startup with a fictional convention, so a teacher can pick it at signup
# and hand a working class code to a student. The private environment holds fictional
# data only; remove both lines at publication — real établissements are created by an
# administrator once their convention is signed.
BRIO_ETABLISSEMENT_PILOTE_NOM=Collège pilote
BRIO_ETABLISSEMENT_PILOTE_TYPE=college

# --- Tutor -----------------------------------------------------------------------
# Real Anthropic key: set a monthly spending cap in the console (ADR 0024 §8).
BRIO_IA_API_KEY=sk-ant-...
# Per-session question cap in the tutor panel (default 20). A restart applies it.
TUTEUR_REQUEST_CAP=20
